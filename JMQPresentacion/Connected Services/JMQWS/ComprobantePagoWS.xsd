<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:tns="http://jmqws.inversiones.jmq.com/" targetNamespace="http://jmqws.inversiones.jmq.com/" version="1.0" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="actualizarComprobante" type="tns:actualizarComprobante" />
  <xs:element name="actualizarComprobanteResponse" type="tns:actualizarComprobanteResponse" />
  <xs:element name="buscarComprobante" type="tns:buscarComprobante" />
  <xs:element name="buscarComprobanteResponse" type="tns:buscarComprobanteResponse" />
  <xs:element name="eliminarComprobante" type="tns:eliminarComprobante" />
  <xs:element name="eliminarComprobanteResponse" type="tns:eliminarComprobanteResponse" />
  <xs:element name="listarComprobantes" type="tns:listarComprobantes" />
  <xs:element name="listarComprobantesResponse" type="tns:listarComprobantesResponse" />
  <xs:element name="registrarComprobante" type="tns:registrarComprobante" />
  <xs:element name="registrarComprobanteResponse" type="tns:registrarComprobanteResponse" />
  <xs:complexType name="buscarComprobante">
    <xs:sequence>
      <xs:element name="id" type="xs:int" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="buscarComprobanteResponse">
    <xs:sequence>
      <xs:element minOccurs="0" name="return" type="tns:comprobantePago" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="comprobantePago" abstract="true">
    <xs:sequence>
      <xs:element minOccurs="0" name="fecha_pago" type="xs:dateTime" />
      <xs:element name="id" type="xs:int" />
      <xs:element minOccurs="0" name="metodoPago" type="tns:metodoPago" />
      <xs:element name="monto_total" type="xs:double" />
      <xs:element minOccurs="0" name="orden" type="tns:ordenVenta" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ordenVenta">
    <xs:sequence>
      <xs:element name="activo" type="xs:boolean" />
      <xs:element minOccurs="0" maxOccurs="unbounded" name="detalle" nillable="true" type="tns:detalle" />
      <xs:element minOccurs="0" name="estado_compra" type="tns:estadoCompra" />
      <xs:element minOccurs="0" name="fecha_orden" type="xs:dateTime" />
      <xs:element name="id" type="xs:int" />
      <xs:element minOccurs="0" name="usuario" type="tns:usuario" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="detalle">
    <xs:sequence>
      <xs:element name="cantidad" type="xs:int" />
      <xs:element minOccurs="0" name="orden" type="tns:ordenVenta" />
      <xs:element name="precio_unitario" type="xs:double" />
      <xs:element minOccurs="0" name="producto" type="tns:producto" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="producto">
    <xs:sequence>
      <xs:element name="activo" type="xs:boolean" />
      <xs:element minOccurs="0" name="categoria" type="tns:categoria" />
      <xs:element minOccurs="0" name="descripcion" type="xs:string" />
      <xs:element name="id" type="xs:int" />
      <xs:element minOccurs="0" name="imagen" type="xs:base64Binary" />
      <xs:element minOccurs="0" name="nombre" type="xs:string" />
      <xs:element name="precio" type="xs:double" />
      <xs:element name="stock" type="xs:int" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="categoria">
    <xs:sequence>
      <xs:element minOccurs="0" name="descripcion" type="xs:string" />
      <xs:element minOccurs="0" name="descuento" type="tns:descuento" />
      <xs:element name="id" type="xs:int" />
      <xs:element minOccurs="0" name="nombre" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="descuento">
    <xs:sequence>
      <xs:element name="activo" type="xs:boolean" />
      <xs:element name="id" type="xs:int" />
      <xs:element name="numDescuento" type="xs:int" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="usuario">
    <xs:sequence>
      <xs:element name="activo" type="xs:boolean" />
      <xs:element minOccurs="0" name="contrasena" type="xs:string" />
      <xs:element minOccurs="0" name="correo" type="xs:string" />
      <xs:element minOccurs="0" name="direccion" type="xs:string" />
      <xs:element minOccurs="0" name="dni" type="xs:string" />
      <xs:element minOccurs="0" name="fecha_expiracion_token" type="xs:dateTime" />
      <xs:element name="id" type="xs:int" />
      <xs:element minOccurs="0" name="nombreUsuario" type="xs:string" />
      <xs:element minOccurs="0" name="RUC" type="xs:string" />
      <xs:element minOccurs="0" name="razonsocial" type="xs:string" />
      <xs:element minOccurs="0" name="tipoUsuario" type="tns:tipoUsuario" />
      <xs:element minOccurs="0" name="token_reset" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="actualizarComprobante">
    <xs:sequence>
      <xs:element minOccurs="0" name="comprobante" type="tns:comprobantePago" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="actualizarComprobanteResponse">
    <xs:sequence />
  </xs:complexType>
  <xs:complexType name="listarComprobantes">
    <xs:sequence />
  </xs:complexType>
  <xs:complexType name="listarComprobantesResponse">
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="return" type="tns:comprobantePago" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="eliminarComprobante">
    <xs:sequence>
      <xs:element name="id" type="xs:int" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="eliminarComprobanteResponse">
    <xs:sequence />
  </xs:complexType>
  <xs:complexType name="registrarComprobante">
    <xs:sequence>
      <xs:element minOccurs="0" name="comprobante" type="tns:comprobantePago" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="registrarComprobanteResponse">
    <xs:sequence />
  </xs:complexType>
  <xs:simpleType name="metodoPago">
    <xs:restriction base="xs:string">
      <xs:enumeration value="efectivo" />
      <xs:enumeration value="tarjeta" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="estadoCompra">
    <xs:restriction base="xs:string">
      <xs:enumeration value="pendiente" />
      <xs:enumeration value="pagado" />
      <xs:enumeration value="enviado" />
      <xs:enumeration value="entregado" />
      <xs:enumeration value="cancelado" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="tipoUsuario">
    <xs:restriction base="xs:string">
      <xs:enumeration value="EMPRESA" />
      <xs:enumeration value="CLIENTE" />
      <xs:enumeration value="ADMIN" />
    </xs:restriction>
  </xs:simpleType>
</xs:schema>
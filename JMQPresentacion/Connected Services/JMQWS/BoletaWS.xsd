      <xs:element name="id" type="xs:int" />
      <xs:element minOccurs="0" name="nombreUsuario" type="xs:string" />
      <xs:element minOccurs="0" name="RUC" type="xs:string" />
      <xs:element minOccurs="0" name="razonsocial" type="xs:string" />
      <xs:element minOccurs="0" name="tipoUsuario" type="tns:tipoUsuario" />
      <xs:element minOccurs="0" name="token_reset" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="buscarBoleta">
    <xs:sequence>
      <xs:element name="arg0" type="xs:int" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="buscarBoletaResponse">
    <xs:sequence>
      <xs:element minOccurs="0" name="return" type="tns:boleta" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="eliminarBoleta">
    <xs:sequence>
      <xs:element name="arg0" type="xs:int" />

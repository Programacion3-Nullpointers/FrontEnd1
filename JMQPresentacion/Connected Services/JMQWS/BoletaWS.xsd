    <xs:sequence>
      <xs:element minOccurs="0" name="arg0" type="tns:boleta" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="actualizarBoletaResponse">
    <xs:sequence />
  </xs:complexType>
  <xs:complexType name="registrarBoleta">
    <xs:sequence>
      <xs:element minOccurs="0" name="arg0" type="tns:boleta" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="registrarBoletaResponse">
    <xs:sequence />
  </xs:complexType>
  <xs:complexType name="hello">
    <xs:sequence>
      <xs:element minOccurs="0" name="name" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="helloResponse">
    <xs:sequence>
      <xs:element minOccurs="0" name="return" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:simpleType name="metodoPago">
    <xs:restriction base="xs:string">
      <xs:enumeration value="efectivo" />
      <xs:enumeration value="tarjeta" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="estadoCompra">
    <xs:restriction base="xs:string">
      <xs:enumeration value="pendiente" />
      <xs:enumeration value="pagado" />
      <xs:enumeration value="enviado" />
      <xs:enumeration value="entregado" />
      <xs:enumeration value="cancelado" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="tipoUsuario">
    <xs:restriction base="xs:string">
      <xs:enumeration value="EMPRESA" />
      <xs:enumeration value="CLIENTE" />
      <xs:enumeration value="ADMIN" />
    </xs:restriction>
  </xs:simpleType>
</xs:schema>
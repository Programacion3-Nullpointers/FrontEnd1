<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MainLayout2.master.cs" Inherits="JMQPresentacion.MainLayout2" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/Public/images/icon.png">
    <link href="/Public/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/Public/fonts/css/all.min.css" rel="stylesheet" />
    <link href="/Public/css/site2.css" rel="stylesheet" />

    <title>Inversiones JMQ Admin</title>
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
    <style>
        .sidebar {
            width: 200px;
            height: 100vh;
            background-color: #2c3e50;
            color: white;
            display: flex;
            flex-direction: column;
            gap: 10px;
            padding: 20px;
            box-sizing: border-box;
            position: fixed;
            left: 0;
            top: 0;
        }

        .menu-title {
            font-weight: bold;
            font-size: 18px;
            color: white;
            text-decoration: none;
            margin-bottom: 20px;
        }

        .menu-item {
            background-color: #34495e;
            padding: 10px;
            border-radius: 6px;
            text-align: center;
            color: white;
            text-decoration: none;
            transition: background-color 0.3s ease;
        }

        .menu-item:hover {
            background-color: #1abc9c;
            color: white;
        }

        .logout {
            margin-top: auto;
            background-color: #e74c3c;
        }

        .logout:hover {
            background-color: #c0392b;
        }

        .main-content {
            margin-left: 220px; /* para que no se superponga con el sidebar */
            padding: 20px;
        }
    </style>
</head>
<body>
    <form id="form1" runat="server">
        <!-- Sidebar -->
        <div class="sidebar">
            <a class="menu-title" href="/Admin/PrincipalAdmin.aspx">Menú</a>
            <a class="menu-item" href="/Admin/ModificarUsuarios.aspx">Usuarios</a>
            <a class="menu-item" href="/Admin/ModificarProductos.aspx">Productos</a>
            <a class="menu-item" href="/Admin/CotizacionesAdmin.aspx">Cotizaciones</a>
            <a class="menu-item" href="/Admin/ModificarCategorias.aspx">Categorias</a>
            <a class="menu-item" href="/Admin/Descuentos.aspx">Descuentos</a>
             <a class="menu-item" href="/Admin/ModificarOrdenes.aspx">Ordenes de Venta</a>
            <a class="menu-item" href="/Admin/Reportes.aspx">Reportes</a>
            <asp:LinkButton ID="btnLogout" runat="server" CssClass="menu-item logout" OnClick="btnLogout_Click">
                Cerrar sesión
            </asp:LinkButton>
        </div>

        <!-- Contenido principal -->
        <div class="main-content">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server" />
        </div>
    </form>
        <!-- Scripts generales -->
    <script src="/Public/js/bootstrap.min.js" type="text/javascript"></script>
    <script src="/Public/js/bootstrap.bundle.min.js" type="text/javascript"></script>
</body>
</html>

<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="MainLayout.master.cs" Inherits="JMQPresentacion.MainLayout" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Inversiones JMQ</title>
    
    <link rel="icon" type="image/x-icon" href="/Public/images/icon.png" />
    <link href="/Public/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link href="/Public/css/site.css" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="head" runat="server" />

    <style>
        .sidebar {
            width: 200px;
            height: 100vh;
            background-color: #6d8bc7;
            color: white;
            display: flex;
            flex-direction: column;
            gap: 10px;
            padding: 20px;
            box-sizing: border-box;
            position: fixed;
            left: 0;
            top: 0;
        }

        .menu-title {
            font-weight: bold;
            font-size: 18px;
            color: white;
            text-decoration: none;
            margin-bottom: 20px;
        }

        .menu-item {
            background-color: #34495e;
            padding: 10px;
            border-radius: 6px;
            text-align: center;
            color: white;
            text-decoration: none;
            transition: background-color 0.3s ease;
        }

        .menu-item:hover {
            background-color: #1abc9c;
            color: white;
        }

        .logout {
            margin-top: auto;
            background-color: #e74c3c;
        }

        .logout:hover {
            background-color: #c0392b;
        }

        .main-content {
            margin-left: 220px;
            padding: 20px;
        }

        nav.navbar {
            margin-left: 200px;
        }

        .mensaje-flotante {
        position: absolute;
        top: 20px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 9999;
        padding: 12px 18px;
        min-width: 300px;
        text-align: center;
        border-radius: 5px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.15);
        font-size: 0.95rem;
        }
    </style>
</head>
<body>
    <form id="form1" runat="server">
        <!-- SIDEBAR -->
        <div class="sidebar">
            <a class="menu-title" href="/Principal/Principal.aspx">Menú</a>
            <a class="menu-item" href="#">Compras</a>
            <a class="menu-item" href="/Cotizaciones/ListaCotizaciones.aspx">Cotizaciones</a>
            
            <asp:LinkButton ID="btnLogout" runat="server" CssClass="menu-item logout" OnClick="btnLogout_Click" Visible="false">
                Logout
            </asp:LinkButton>
        </div>

        <!-- NAVBAR -->
        <nav class="navbar navbar-dark" style="background-color:#6d8bc7;">
            <div class="container-fluid d-flex justify-content-between align-items-center">
                <a href="/Principal/Principal.aspx" class="navbar-brand">
                    <img alt="Logo" src="/Public/images/logo1.png" style="width:150px;">
                </a>

                <!-- 🔧 CORREGIDO: Reemplazado form por div -->
                <div class="d-flex">
                    <button class="btn px-3 py-2 me-3" style="background-color: #1B4592; color: white; border: none;" type="button" data-bs-toggle="offcanvas" data-bs-target="#categoriesMenu">
                        <i class="fas fa-bars"></i> Categorías
                    </button>

                    <div class="offcanvas offcanvas-start" tabindex="-1" id="categoriesMenu">
                        <div class="offcanvas-header">
                            <h5 class="offcanvas-title">¡Hola!</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
                        </div>
                        <div class="offcanvas-body">
                            <ul class="list-group">
                                <li class="list-group-item">Herramientas</li>
                                <li class="list-group-item">Maquinaria</li>
                                <li class="list-group-item">Limpieza</li>
                                <li class="list-group-item">Pintura</li>
                                <li class="list-group-item">Disolventes</li>
                            </ul>
                        </div>
                    </div>

                    <input class="form-control me-2" type="search" style="width:500px;" placeholder="Buscar..." />
                    <button class="btn btn-outline-light" type="submit"><i class="fas fa-search"></i></button>
                </div>
                <!-- 🔧 FIN DE CORRECCIÓN -->

                <div class="d-flex gap-2">
                    <asp:PlaceHolder ID="phLogin" runat="server" Visible="false">
                        <a href="/Login/Login.aspx" class="btn btn-outline-light" title="Iniciar sesión">
                            <i class="fa-solid fa-user"></i>
                        </a>
                    </asp:PlaceHolder>

                    <asp:PlaceHolder ID="phLogout" runat="server" Visible="false">
                        <asp:LinkButton ID="btnLogoutTop" runat="server" CssClass="btn btn-outline-danger" OnClick="btnLogout_Click" ToolTip="Cerrar sesión">
                            <i class="fa-solid fa-right-from-bracket"></i>
                        </asp:LinkButton>
                    </asp:PlaceHolder>

                    <a href="/Pedidos/Carrito.aspx" class="btn btn-outline-light position-relative" title="Ver carrito">
                        <i class="fa-solid fa-cart-shopping"></i>
                        <asp:Literal ID="litCantidadCarrito" runat="server" />
                    </a>
                </div>
            </div>
        </nav>

        <!-- CONTENIDO PRINCIPAL -->
        <div class="main-content">
            <asp:ContentPlaceHolder ID="Contenido" runat="server" />
        </div>

        <!-- Scripts específicos -->
        <asp:ContentPlaceHolder ID="Scripts" runat="server" />
    </form>

    <!-- Scripts generales -->
    <script src="/Public/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</body>
</html>

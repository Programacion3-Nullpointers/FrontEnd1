<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="MainLayout.master.cs" Inherits="JMQPresentacion.MainLayout" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/Public/images/icon.png">
    <link href="/Public/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/Public/fonts/css/all.min.css" rel="stylesheet" />
    <link href="/Public/css/site.css" rel="stylesheet" />

    <title>Inversiones JMQ</title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <style>
        .sidebar {
            width: 200px;
            height: 100vh;
            background-color: #6d8bc7;
            color: white;
            display: flex;
            flex-direction: column;
            gap: 10px;
            padding: 20px;
            box-sizing: border-box;
            position: fixed;
            left: 0;
            top: 0;
        }

        .menu-title {
            font-weight: bold;
            font-size: 18px;
            color: white;
            text-decoration: none;
            margin-bottom: 20px;
        }

        .menu-item {
            background-color: #34495e;
            padding: 10px;
            border-radius: 6px;
            text-align: center;
            color: white;
            text-decoration: none;
            transition: background-color 0.3s ease;
        }

        .menu-item:hover {
            background-color: #1abc9c;
            color: white;
        }

        .logout {
            margin-top: auto;
            background-color: #e74c3c;
        }

        .logout:hover {
            background-color: #c0392b;
        }
        .main-content {
            margin-left: 220px; /* para que no se superponga con el sidebar */
            padding: 20px;
        }
        nav.navbar {
            margin-left: 200px; /* mismo ancho del sidebar */
        }
    </style>

</head>
<body>
    <div class="container-fluid p-0 d-flex h-100">
        <div class="bg-white flex-fill">
            <div class="p-2 d-md-none d-flex text-white bg-primary">
                <a href="#" class="text-white"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#bdSidebar">
                    <i class="fa-solid fa-bars"></i>
                </a>
                <span class="ms-3">LOGO JMQ</span>
            </div>

            <nav class="navbar navbar-dark" style="background-color:#6d8bc7; z-index: 1000; position: relative;">
                <div class="container-fluid d-flex justify-content-between align-items-center">
                    <a href="/Principal/Principal.aspx" class="navbar-brand">
                        <img alt="Logo" src="/Public/images/logo1.png" style="width:150px;">
                    </a>

                    <form class="d-flex">
                        <button class="btn px-3 py-2 me-3" style="background-color: #1B4592; color: white; border: none;" type="button" data-bs-toggle="offcanvas" data-bs-target="#categoriesMenu">
                            <i class="fas fa-bars"></i> Categorías
                        </button>

                        <div class="offcanvas offcanvas-start" tabindex="-1" id="categoriesMenu">
                            <div class="offcanvas-header">
                                <h5 class="offcanvas-title">¡Hola!</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
                            </div>
                            <div class="offcanvas-body">
                                <ul class="list-group">
                                    <li class="list-group-item">Herramientas</li>
                                    <li class="list-group-item">Maquinaria</li>
                                    <li class="list-group-item">Limpieza</li>
                                    <li class="list-group-item">Pintura</li>
                                    <li class="list-group-item">Disolventes</li>
                                </ul>
                            </div>
                        </div>
                        <input class="form-control me-2" type="search" style="width:500px;" placeholder="Buscar..." aria-label="Search">
                        <button class="btn btn-outline-light" type="submit"><i class="fas fa-search"></i></button>
                    </form>

                    <div class="d-flex gap-2">
                        <a href="/Login/Login.aspx" class="btn btn-outline-light" title="Iniciar sesión">
                            <i class="fa-solid fa-user"></i>
                        </a>
                        <a href="/Pedidos/Carrito.aspx" class="btn btn-outline-light">
                            <i class="fa-solid fa-cart-shopping"></i>
                        </a>
                    </div>
                </div>
            </nav>

            <div class="container-fluid p-0 d-flex h-100">
                <form id="form1" runat="server">
                    <!-- Sidebar -->
                    <div class="sidebar">
                        <a class="menu-title" href="/Principal/Principal.aspx">Menú</a>
                        <a class="menu-item" >Compras</a>
                        <a class="menu-item" href="/Cotizaciones/ListaCotizaciones.aspx">Cotizaciones</a>
                        
                        <asp:LinkButton ID="btnLogout" runat="server" CssClass="menu-item logout" OnClick="btnLogout_Click" Visible="false">
                            Logout
                        </asp:LinkButton>
                    </div>

                    <!-- Contenido principal -->
                    <div class="main-content">
                        <asp:ContentPlaceHolder ID="Contenido" runat="server" />
                    </div>
                    
                </form>
            </div>
        </div>
    </div>
    
    <script src="/Public/js/bootstrap.min.js" type="text/javascript"></script>
    <script src="/Public/js/bootstrap.bundle.min.js" type="text/javascript"></script>

    <asp:ContentPlaceHolder ID="Scripts" runat="server">
    </asp:ContentPlaceHolder>
</body>
</html>